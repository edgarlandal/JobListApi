      "cors_wildcard": false,
      "cors_all_https": false
    },
    ".env.production": {
      "exists": true,
      "tracked": false,
      "jwt_at_least_32_chars": false,
      "jwt_has_placeholder_marker": false,
      "access_minutes": "30",
      "debug": "false",
      "db_host_is_compose_service": false,
      "db_port_is_internal": false,
      "redis_uses_compose_service": true,
      "postgres_credentials_match_db": false,
      "cors_valid_json_list": true,
      "cors_wildcard": false,
